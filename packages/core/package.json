{
  "name": "bracer",
  "version": "1.0.0",
  "type": "module",
  "description": "JSON toolkit for LLM workflows: repair broken LLM JSON, convert JSON <-> TOON/YAML/XML/CSV/TOML, generate TypeScript/Zod/JSON Schema, and count tokens.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "pretest": "npm run build",
    "test": "node --test test/core.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "fast-xml-parser": "^5.3.2",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.15.0",
    "papaparse": "^5.5.3",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.0",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "json",
    "converter",
    "repair",
    "toon",
    "yaml",
    "toml",
    "xml",
    "csv",
    "zod",
    "typescript",
    "json-schema",
    "tokens",
    "mcp"
  ],
  "license": "MIT",
  "author": "Nuzair Palwala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentry007/Braces_Proto.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sentry007/Braces_Proto#readme",
  "bugs": {
    "url": "https://github.com/sentry007/Braces_Proto/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
