{
  "name": "@braces/core",
  "version": "2.1.0",
  "type": "module",
  "description": "Core engine for Braces Reborn: polyglot conversion, JSON repair, schema generation, and token optimization",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "node --test test/core.test.js"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@toon-format/toon": "^1.3.0",
    "fast-xml-parser": "^5.3.2",
    "js-yaml": "^4.1.1",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.0",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "json",
    "converter",
    "repair",
    "toon",
    "yaml",
    "toml",
    "xml",
    "csv",
    "zod",
    "typescript",
    "json-schema",
    "tokens",
    "mcp"
  ],
  "license": "MIT"
}
