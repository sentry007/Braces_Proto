{
  "name": "bracer-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.sentry007/bracer-mcp",
  "description": "MCP server for LLM JSON workflows: repair broken JSON, convert JSON <-> TOON/YAML/XML/CSV/TOML, generate TypeScript/Zod/JSON Schema, and cut prompt tokens.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bracer-mcp": "bin/bracer-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Nuzair Palwala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentry007/Braces_Proto.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/sentry007/Braces_Proto#readme",
  "bugs": {
    "url": "https://github.com/sentry007/Braces_Proto/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "start": "node bin/bracer-mcp.js",
    "pretest": "npm run build",
    "test": "node --test test/mcp.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "bracer": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json",
    "repair",
    "toon",
    "yaml",
    "converter",
    "ai",
    "llm",
    "claude",
    "cursor"
  ],
  "license": "MIT"
}
