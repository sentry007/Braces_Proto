{
  "name": "braces-reborn-monorepo",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=braces-web",
    "build:core": "npm run build --workspace=@braces/core",
    "build:web": "npm run build --workspace=braces-web",
    "build:mcp": "npm run build --workspace=braces-mcp",
    "build:vscode": "npm run build --workspace=braces-vscode",
    "build": "npm run build:core && npm run build:web && npm run build:mcp && npm run build:vscode",
    "test": "npm run test --workspace=@braces/core && npm run test --workspace=braces-mcp",
    "lint": "eslint packages/web/src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3"
  }
}
